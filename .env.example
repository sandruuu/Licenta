# ========================================
# TrustCloud Lab - Environment Variables
# ========================================
# Copy this file to .env and fill in secure values:
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -hex 32
# ========================================

# JWT signing secret for the PDP IdP (min 32 chars)
JWT_SECRET=

# Inter-service auth token for session store (min 32 chars)
SESSION_STORE_TOKEN=

# Gateway admin panel credentials
ADMIN_EMAIL=admin@gateway.local
ADMIN_PASSWORD=

# RDP test desktop credentials
RDP_USER=testuser
RDP_PASSWORD=

# SSH test server credentials
SSH_USER=testuser
SSH_PASSWORD=

# Optional free IdP for local OIDC federation tests (Keycloak)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional Keycloak -> PDP SCIM connector for local directory sync.
# Run with:
#   docker compose --profile directory-sync up -d --build keycloak-scim-sync
#
# Set these after creating the organization and IdP in PDP.
KEYCLOAK_SCIM_SYNC_TENANT_ID=
KEYCLOAK_SCIM_SYNC_SCIM_TOKEN=
KEYCLOAK_SCIM_SYNC_REALM=trustcloud-lab
KEYCLOAK_SCIM_SYNC_INTERVAL=60s

# Optional public PDP/PA dashboard exposure through docker-compose.public.yml.
# Example:
#   PDP_PUBLIC_HOST=policy-admin.remote-access-demo.xyz
PDP_PUBLIC_HOST=
PDP_ADMIN_REQUIRE_MFA=true
PDP_FEDERATED_CALLBACK_URL=
PDP_WEBAUTHN_RP_ID=
PDP_WEBAUTHN_RP_ORIGINS=
