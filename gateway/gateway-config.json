{
  "listen_addr": ":9443",
  "fqdn": "gateway.local",
  "tls_cert": "./certs/gateway-ssl.crt",
  "tls_key": "./certs/gateway-ssl.key",
  "tls_ca": "./certs/ca.crt",
  "client_ca": "./certs/ca.crt",
  "cloud_ca": "./certs/ca.crt",
  "require_client_cert": true,
  "mtls_cert": "./certs/gateway-mtls.crt",
  "mtls_key": "./certs/gateway-mtls.key",
  "mtls_csr": "./certs/gateway-mtls.csr",
  "cloud_url": "https://localhost:8443",
  "enrollment_token": "",
  "control_plane": {
    "enabled": true,
    "pa_url": "https://localhost:8443",
    "gateway_id": "gateway-local",
    "gateway_endpoint": "localhost:9443",
    "ca_file": "./certs/ca.crt",
    "cert_file": "./certs/gateway-mtls.crt",
    "key_file": "./certs/gateway-mtls.key",
    "reconnect_min_seconds": 1,
    "reconnect_max_seconds": 30
  },
  "pki_url": "",
  "pki_token": "",
  "pki_path": "pki_int",
  "pki_role_gateway": "ztna-gateway",
  "max_relay_bandwidth_mbps": 400
}