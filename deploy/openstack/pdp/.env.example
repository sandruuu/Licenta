PDP_IMAGE=trustcloud-pdp:latest

PDP_PUBLIC_HOST=replace-with-pdp-domain.example

PDP_FQDN=pdp

VAULT_PRIVATE_IP=10.20.40.102

PDP_PKI_URL=https://vault:8200
PDP_PKI_CA_FILE=/app/vault-ca/vault-ca.crt
PDP_PKI_SERVER_NAME=vault
PDP_PKI_TOKEN=replace-with-token-from-vault-bootstrap
PDP_PKI_PATH=pki_int
PDP_PKI_ROLE_PDP=trustcloud
PDP_PKI_ROLE_DEVICE=trustagent
PDP_PKI_ROLE_GATEWAY=trustgateway
PDP_TRANSIT_KEY=trustcloud-key

POSTGRES_DB=trustcloud
POSTGRES_USER=trustcloud
POSTGRES_PASSWORD=replace-with-strong-postgres-password

PDP_REDIS_URL=redis://redis:6379/0

PDP_ADMIN_REQUIRE_MFA=true
