# ============================================================
#  ZTNA — Root .gitignore
#  Generated after full project analysis (2026-05-11)
# ============================================================

# ── Secrets & Environment ──
# .env contains JWT_SECRET, passwords — NEVER COMMIT REAL SECRETS
.env
.env.local
.env.*.local

# ── Certificates & Keys (sensitive material) ──
*.pem
*.key
!*.pub                    # allow public keys (e.g. jwt-signing.pub)
*.crt
*.pfx
*.p12

# ── Database ──
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Binaries ──
# Compiled Go / Wails output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.test.exe

# ── Build output ──
build/bin/
dist/
dist-ssr/
frontend/dist/

# ── Node.js dependencies ──
node_modules/
package-lock.json.md5    # Wails auto-generated checksum

# ── Go ──
vendor/

# ── IDE / Editor ──
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.csproj
*.user
*.orig

# ── Logs ──
*.log
*.err
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime / transient data ──
data/
certs/
tmp/
temp/
*.tmp

# ── OS files (Windows / macOS / Linux) ──
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db
Icon?

# ── Archives / large binary files ──
*.zip
*.tar.gz
*.tar
*.tgz
*.7z
*.rar
*.dat
*.raw
*.bin
*.msi

# ── Coverage / profiling ──
*.coverprofile
*.prof
coverage/
coverage.out

# ── Docker (keep Dockerfiles, ignore runtime overrides) ──
docker-compose.override.yml
