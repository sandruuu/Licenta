# ============================================================
#  TrustCloud Environment Variables
#  Used by both PDP (native) and docker-compose
# ============================================================

# --- Shared Secrets ---
JWT_SECRET=trustcloud-jwt-secret-change-in-production-2024
SESSION_STORE_TOKEN=trustcloud-session-store-token-change-in-production-2024

# --- PDP Admin (created on first run) ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# --- RDP Desktop ---
RDP_USER=admin
RDP_PASSWORD=admin

# --- SSH Server ---
SSH_USER=admin
SSH_PASSWORD=admin


# --- Local Keycloak -> PDP SCIM sync ---
KEYCLOAK_SCIM_SYNC_TENANT_ID=org_pdp_test_admin
KEYCLOAK_SCIM_SYNC_SCIM_TOKEN=local-scim-token-123
KEYCLOAK_SCIM_SYNC_REALM=trustcloud-lab
KEYCLOAK_SCIM_SYNC_INTERVAL=60s
